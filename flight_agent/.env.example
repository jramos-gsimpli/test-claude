# Credenciales Amadeus API (https://developers.amadeus.com)
# Registro gratuito - usar entorno "test" para desarrollo
AMADEUS_CLIENT_ID=your_client_id_here
AMADEUS_CLIENT_SECRET=your_client_secret_here

# Configuracion SMTP para envio de mails
# Gmail: activar "Contrasena de aplicacion" en tu cuenta Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password_aqui
